# Set these in your shell; this file is documentation, not loaded automatically.
NBA_MODEL_DIR=models
NBA_CACHE_DIR=data/cache
NBA_TRAINING_ENABLED=false
# phase3_api.py enables on-demand player models for the same-origin loopback dashboard.
# Remote clients still require the protected training key. Set false to disable locally.
NBA_LOCAL_PLAYER_MODELS=true
# A random secret of at least 16 characters is required when enabling API training.
NBA_TRAINING_API_KEY=
NBA_REQUEST_TIMEOUT=10
NBA_RETRIES=2
NBA_CACHE_TTL_SECONDS=86400
NBA_ALLOW_STALE_CACHE=true
# Comma-separated explicit origins. Empty means same-origin dashboard only.
NBA_CORS_ORIGINS=
